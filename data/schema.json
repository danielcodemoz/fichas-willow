{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willow worksheet question bank \u2013 one topic file (data/gradeN/<topic>.json)",
  "description": "Reference schema for editors. The authoritative check is `node tests/validate-bank.js`, which also enforces cross-file rules (unique ids, >= 20 questions, every question type present, manifest consistency).",
  "type": "object",
  "required": [
    "grade",
    "topic",
    "title",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "grade": {
      "enum": [
        7,
        8,
        9
      ]
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "difficulty",
        "q"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g[789]-[a-z]+-\\d{2,3}$"
        },
        "type": {
          "enum": [
            "mcq",
            "tf",
            "fill",
            "short",
            "match"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "q": {
          "$ref": "#/$defs/text"
        },
        "code": {
          "$ref": "#/$defs/text"
        },
        "explain": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "mcq"
            },
            "options": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "options",
            "answer"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "tf"
            },
            "answer": {
              "type": "boolean"
            }
          },
          "required": [
            "answer"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "fill"
            },
            "answer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "required": [
            "answer"
          ],
          "description": "q must contain one ____ per answer item"
        },
        {
          "properties": {
            "type": {
              "const": "short"
            },
            "answer": {
              "$ref": "#/$defs/text"
            },
            "marks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [
            "answer",
            "marks"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "match"
            },
            "pairs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "required": [
            "pairs"
          ]
        }
      ]
    }
  }
}
